# 将本模板复制为 .env，再填写本地模型凭证。
PORT=3001
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=your_api_key_here
TOOL_MODE=mock
DB_PATH=./data/agent-run.db
# * 允许浏览本机日志和 TrajErrBench 测试轨迹，凭证与离线评测答案由服务端隔离。
# 如需限制普通目录，使用逗号分隔的根目录，例如 ./data/fixtures,../Database/new data。
ALLOWED_TRACE_ROOTS=*
